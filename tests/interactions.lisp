(in-package #:cl-raygui.tests)

;; These resolve only in the dedicated test backend. The runner starts a fresh
;; process with CL_RAYGUI_LIBRARY set before loading any Lisp bindings.
(cffi:defcfun ("ClRayguiTestFrame" input-frame) :void
  (x :float) (y :float) (buttons :int) (key :int) (codepoint :int) (wheel :float))
(cffi:defcfun ("ClRayguiTestReset" reset-interaction) :void)
(cffi:defcfun ("ClRayguiTestDrawCalls" interaction-draw-calls) :int)

(defun frame (&key (x 30) (y 25) down pressed released middle (key -1) (char 0) (wheel 0))
  (input-frame (float x 1.0) (float y 1.0)
               (logior (if down 1 0) (if pressed 2 0) (if released 4 0) (if middle 8 0))
               key (if (characterp char) (char-code char) char) (float wheel 1.0)))

(defun test-bounds (&optional (x 10) (y 10) (width 200) (height 30))
  (cl-raylib:make-rectangle :x x :y y :width width :height height))

(defun run-interaction-tests ()
  "Script frames through real raygui and the public Lisp API, without a display."
  (unless (cffi:foreign-symbol-pointer "ClRayguiTestReset")
    (error "Interaction tests require the isolated backend; use tools/run-tests.py."))
  (let ((checks 0) (scenarios 0))
    (flet ((check (condition description)
             (incf checks)
             (unless condition (error "Interaction check failed: ~A" description)))
           (scenario (description)
             (incf scenarios)
             (format t "~&  ~A~%" description)
             (reset-interaction)))
      (scenario "Button press, release, idle and outside bounds")
      (frame :down t :pressed t)
      (check (not (raygui:gui-button (test-bounds) "Button")) "press waits for release")
      (frame :released t)
      (multiple-value-bind (clicked flags) (raygui:gui-button (test-bounds) "Button")
        (check clicked "release produces Lisp true")
        (check (raygui:result-pressed-p flags) "release sets PRESSED"))
      (frame)
      (check (not (raygui:gui-button (test-bounds) "Button")) "idle produces NIL")
      (frame :x 500 :released t)
      (check (not (raygui:gui-button (test-bounds) "Button")) "outside release ignored")

      (scenario "Checkbox and toggle preserve updated boolean state")
      (frame :released t)
      (multiple-value-bind (checked flags) (raygui:gui-check-box (test-bounds) "Check" nil)
        (check checked "checkbox changes NIL to T")
        (check (raygui:result-changed-p flags) "checkbox sets CHANGED")
        (frame)
        (check (raygui:gui-check-box (test-bounds) "Check" checked) "checkbox persists")
        (frame :released t)
        (check (null (raygui:gui-check-box (test-bounds) "Check" checked)) "checkbox toggles back"))
      (multiple-value-bind (active flags) (raygui:gui-toggle (test-bounds) "Toggle" nil)
        (check active "toggle changes NIL to T")
        (check (raygui:result-changed-p flags) "toggle reports CHANGED"))

      (scenario "Disabled and locked background controls ignore input")
      (frame :released t)
      (raygui:gui-disable)
      (check (not (raygui:gui-button (test-bounds) "Disabled")) "disabled button ignores release")
      (check (null (raygui:gui-check-box (test-bounds) "Disabled" nil)) "disabled checkbox unchanged")
      (raygui:gui-enable)
      (raygui:gui-lock)
      (check (not (raygui:gui-button (test-bounds) "Background")) "locked background ignores release")
      (raygui:gui-unlock)
      (check (raygui:gui-button (test-bounds) "Foreground") "unlocked foreground accepts same input")

      (scenario "Dropdown opens, changes entry, and dismisses without changing")
      (frame :pressed t :down t)
      (multiple-value-bind (active flags)
          (raygui:gui-dropdown-box (test-bounds) "One;Two;Three" 0 nil)
        (check (= active 0) "opening preserves selection")
        (check (raygui:result-pressed-p flags) "opening returns PRESSED"))
      (frame :y 90 :released t)
      (multiple-value-bind (active flags)
          (raygui:gui-dropdown-box (test-bounds) "One;Two;Three" 0 t)
        (check (= active 1) "second entry selected")
        (check (raygui:result-changed-p flags) "different entry returns CHANGED")
        (check (not (raygui:result-pressed-p flags)) "CHANGED alone must also close example popup"))
      (frame :x 500 :pressed t)
      (multiple-value-bind (active flags)
          (raygui:gui-dropdown-box (test-bounds) "One;Two;Three" 1 t)
        (check (= active 1) "outside click preserves selection")
        (check (raygui:result-pressed-p flags) "outside click dismisses with PRESSED"))

      (scenario "Slider drag continues outside bounds and clamps at both ends")
      (let ((value 0.0))
        (frame :x 110 :down t :pressed t)
        (multiple-value-bind (updated flags)
            (raygui:gui-slider (test-bounds) nil nil value 0 1)
          (setf value updated)
          (check (< (abs (- value 0.5)) 0.001) "middle drag yields 0.5")
          (check (raygui:result-changed-p flags) "drag returns CHANGED"))
        (frame :x 500 :down t)
        (setf value (raygui:gui-slider (test-bounds) nil nil value 0 1))
        (check (= value 1.0) "drag past right edge clamps to maximum")
        (frame :x -200 :down t)
        (setf value (raygui:gui-slider (test-bounds) nil nil value 0 1))
        (check (= value 0.0) "drag past left edge clamps to minimum")
        (frame :released t)
        (raygui:gui-slider (test-bounds) nil nil value 0 1)
        (frame :x 400 :down t)
        (check (= value (raygui:gui-slider (test-bounds) nil nil value 0 1))
               "released slider no longer captures outside movement"))

      (scenario "Text editing accepts UTF-8, backspace, Enter, and a second buffer")
      (raygui:with-text-buffer (buffer 32 "A")
        (raygui:with-text-buffer (other 32 "Other")
          (frame :pressed t)
          (check (raygui:result-pressed-p
                   (nth-value 1 (raygui:gui-text-box (test-bounds) buffer nil)))
                 "click enters edit mode")
          (frame :char #\é)
          (check (string= "Aé" (raygui:gui-text-box (test-bounds) buffer t)) "UTF-8 input appended")
          (frame :char #\二)
          (check (string= "Aé二" (raygui:gui-text-box (test-bounds) buffer t)) "three-byte input appended")
          (frame :key 259) ; KEY_BACKSPACE
          (check (string= "Aé" (raygui:gui-text-box (test-bounds) buffer t)) "backspace removes complete codepoint")
          (frame :key 257) ; KEY_ENTER
          (check (raygui:result-pressed-p
                   (nth-value 1 (raygui:gui-text-box (test-bounds) buffer t))) "Enter exits editing")
          (frame :pressed t)
          (raygui:gui-text-box (test-bounds) other nil)
          (frame :char #\!)
          (check (string= "Other!" (raygui:gui-text-box (test-bounds) other t)) "second field has its own storage")
          (check (string= "Aé" (raygui:text-buffer-string buffer)) "first field unchanged")
          (frame :x 500 :pressed t)
          (check (raygui:result-pressed-p
                   (nth-value 1 (raygui:gui-text-box (test-bounds) other t))) "outside click exits editing")))

      (scenario "Typing respects UTF-8 byte capacity and retains a NUL terminator")
      (raygui:with-text-buffer (buffer 5 "")
        (frame :pressed t)
        (raygui:gui-text-box (test-bounds) buffer nil)
        (frame :char #x1f600)
        (check (= 4 (length (babel:string-to-octets
                              (raygui:gui-text-box (test-bounds) buffer t) :encoding :utf-8)))
               "four-byte codepoint fits exactly with terminator")
        (frame :char #\X)
        (raygui:gui-text-box (test-bounds) buffer t)
        (check (= 4 (length (babel:string-to-octets (raygui:text-buffer-string buffer) :encoding :utf-8)))
               "extra input does not overflow")
        (check (zerop (cffi:mem-aref (raygui:text-buffer-pointer buffer) :unsigned-char 4)) "terminator remains in bounds"))

      (scenario "Integer and float input update values and report edit completion")
      (frame :char #\7)
      (check (= 7 (raygui:gui-value-box (test-bounds) nil 0 0 100 t)) "typed integer returned")
      (frame :key 257)
      (check (raygui:result-pressed-p
               (nth-value 1 (raygui:gui-value-box (test-bounds) nil 7 0 100 t))) "integer Enter result")
      (raygui:with-text-buffer (buffer 33 "1.")
        (frame :char #\5)
        (multiple-value-bind (value text flags)
            (raygui:gui-value-box-float (test-bounds) nil buffer 1 t)
          (check (= 1.5 value) "float numeric value returned first")
          (check (string= "1.5" text) "float text returned second")
          (check (integerp flags) "float flags returned third")))

      (scenario "List selection, focus, scrolling, and multiple-value ordering")
      (let ((items (loop for i below 20 collect (format nil "Item ~D" i))))
        (frame :y 55 :pressed t)
        (multiple-value-bind (active scroll focus flags)
            (raygui:gui-list-view-ex (test-bounds 10 10 200 120) items 3 -1 -1)
          (check (= active 4) "second visible entry at scroll 3 selects item 4")
          (check (= scroll 3) "scroll returned second")
          (check (= focus 4) "focus returned third")
          (check (raygui:result-changed-p flags) "list selection returns CHANGED"))
        (frame :wheel -2)
        (multiple-value-bind (active scroll focus)
            (raygui:gui-list-view-ex (test-bounds 10 10 200 120) items 3 4 -1)
          (declare (ignore focus))
          (check (= active 4) "scrolling preserves selected item")
          (check (= scroll 5) "wheel scroll updates index"))
        (frame :x 500)
        (multiple-value-bind (active scroll focus)
            (raygui:gui-list-view-ex (test-bounds 10 10 200 120) items 5 4 4)
          (check (equal (list active scroll focus) '(4 5 -1)) "all three returned values remain distinct")))

      (scenario "Scroll panel wheel input returns scroll vector and viewport")
      (frame :x 80 :y 50 :wheel -1)
      (multiple-value-bind (scroll view flags)
          (raygui:gui-scroll-panel (test-bounds 10 10 200 120) nil
                                  (test-bounds 0 0 600 600) (3d-vectors:vec 0 0))
        (check (minusp (3d-vectors:vy scroll)) "wheel scrolls content vertically")
        (check (zerop (3d-vectors:vx scroll)) "vertical wheel preserves horizontal offset")
        (check (< 0 (cl-raylib:rectangle-width view) 200) "viewport accounts for scrollbar")
        (check (< 0 (cl-raylib:rectangle-height view) 120) "viewport accounts for borders")
        (check (integerp flags) "scroll flags returned third"))

      (scenario "HSV color panel and alpha bar update floating point state")
      (frame :x 110 :y 60 :down t :pressed t)
      (multiple-value-bind (hsv flags)
          (raygui:gui-color-panel-hsv (test-bounds 10 10 200 100) nil (3d-vectors:vec 180 0 0))
        (check (= 180 (3d-vectors:vx hsv)) "panel preserves hue")
        (check (< (abs (- 0.5 (3d-vectors:vy hsv))) 0.001) "panel updates saturation")
        (check (< (abs (- 0.5 (3d-vectors:vz hsv))) 0.001) "panel updates brightness")
        (check (raygui:result-changed-p flags) "HSV panel reports CHANGED"))
      ;; Release the panel's exclusive drag before operating another control.
      (frame)
      (raygui:gui-color-panel-hsv (test-bounds 10 10 200 100) nil (3d-vectors:vec 180 0.5 0.5))
      (frame :x 160 :down t)
      (check (< (abs (- 0.75 (raygui:gui-color-bar-alpha (test-bounds) nil 0))) 0.001)
             "alpha bar updates scalar state")

      (scenario "Tab switching and close flags")
      (frame :x 200 :released t)
      (multiple-value-bind (active scroll flags)
          (raygui:gui-tab-bar (test-bounds 10 10 600 30) "One;Two;Three" 0 0)
        (check (= active 1) "second tab activated")
        (check (= scroll 0) "tab scroll returned separately")
        (check (raygui:result-changed-p flags) "tab switch reports CHANGED"))
      (frame :x 200 :middle t)
      (check (raygui:result-tab-close-p
               (nth-value 2 (raygui:gui-tab-bar (test-bounds 10 10 600 30) "One;Two;Three" 0 1)))
             "middle click reports TAB_CLOSE")

      (scenario "Modal dialog locks background and returns correct button indices")
      (frame :x 50 :y 180 :released t)
      (raygui:gui-lock)
      (check (not (raygui:gui-button (test-bounds 10 140 200 50) "Behind dialog")) "background cannot consume dialog click")
      (raygui:gui-unlock)
      (multiple-value-bind (button flags)
          (raygui:gui-message-box (test-bounds 10 10 300 200) "Confirm" "Apply?" "Apply;Cancel")
        (check (= button 1) "first dialog button is index 1")
        (check (raygui:result-pressed-p flags) "dialog returns PRESSED"))
      (frame :x 220 :y 180 :released t)
      (check (= 2 (raygui:gui-message-box (test-bounds 10 10 300 200) "Confirm" "Apply?" "Apply;Cancel")) "cancel is index 2")
      (frame :x 295 :y 22 :released t)
      (check (= 0 (raygui:gui-message-box (test-bounds 10 10 300 200) "Confirm" "Apply?" "Apply;Cancel")) "window close is index 0")
      (frame)
      (check (= -1 (raygui:gui-message-box (test-bounds 10 10 300 200) "Confirm" "Apply?" "Apply;Cancel")) "idle is index -1")

      (scenario "Text input dialog preserves visibility, edits text, and accepts")
      (raygui:with-text-buffer (buffer 64 "Ada")
        ;; For these bounds the input field begins near y=130.
        (frame :x 40 :y 145 :pressed t)
        (raygui:gui-text-input-box (test-bounds 10 10 400 220) "Name" "Name:" buffer "Accept;Cancel" -1 t)
        (frame :char #\!)
        (multiple-value-bind (text button visible flags)
            (raygui:gui-text-input-box (test-bounds 10 10 400 220) "Name" "Name:" buffer "Accept;Cancel" -1 t)
          (declare (ignore flags))
          (check (string= "Ada!" text) "dialog edits persistent buffer")
          (check (= button -1) "typing does not accept dialog")
          (check visible "visibility state is returned"))
        (frame :x 70 :y 204 :released t)
        (multiple-value-bind (text button visible flags)
            (raygui:gui-text-input-box (test-bounds 10 10 400 220) "Name" "Name:" buffer "Accept;Cancel" -1 t)
          (declare (ignore text visible))
          (check (= button 1) "accept button index returned second")
          (check (raygui:result-pressed-p flags) "accept returns PRESSED")))
      (check (plusp (interaction-draw-calls)) "real raygui reaches drawing backend")
      (reset-interaction))
    (format t "~&cl-raygui: ~D interaction checks in ~D scenarios passed.~%" checks scenarios)
    t))
