(defpackage #:cl-raygui.tests
  (:use #:cl)
  (:export #:run-tests #:run-abi-tests #:run-graphics-tests #:run-interaction-tests))
(in-package #:cl-raygui.tests)

(defun signals-error-p (function)
  (handler-case (progn (funcall function) nil) (error () t)))

(defun run-tests ()
  "Run headless checks, restoring the global state changed by the tests."
  (let ((state (raygui:gui-get-state))
        (locked (raygui:gui-is-locked))
        (button-color (raygui:gui-get-style raygui:+button+ raygui:+base-color-normal+))
        (tooltip (unless (cffi:null-pointer-p cl-raygui::*tooltip-pointer*)
                   (cffi:foreign-string-to-lisp cl-raygui::*tooltip-pointer* :encoding :utf-8))))
    (unwind-protect
         (progn
           (raygui:gui-set-state raygui:+state-normal+)
           (raygui:gui-unlock)
           (%run-headless-tests))
      (raygui:gui-set-style raygui:+button+ raygui:+base-color-normal+ button-color)
      (raygui:gui-set-state state)
      (if locked (raygui:gui-lock) (raygui:gui-unlock))
      (raygui:gui-set-tooltip tooltip))))

(defun %run-headless-tests ()
  "Headless checks: native symbols, global state, ownership, encodings and types."
  (let ((count 0))
    (flet ((check (condition)
             (incf count)
             (assert condition)))
      ;; Check every declared C function exists in the actual native library.
      (do-external-symbols (symbol :cl-raygui.raw)
        (when (and (fboundp symbol)
                   (uiop:string-prefix-p "GUI-" (symbol-name symbol)))
          (check (cffi:foreign-symbol-pointer
                  (cffi:translate-camelcase-name symbol :upper-initial-p t
                                                :special-words '("HSV"))))))
      (check (= 1 (cffi:foreign-type-size 'cl-raygui.raw::c-bool)))
      (check (= 8 (cffi:foreign-type-size '(:struct raygui:gui-style-prop))))
      (check (= 16 (cffi:foreign-type-size '(:struct cl-raylib::%rectangle))))
      (check (not (raygui:result-pressed-p 0)))
      (check (raygui:result-pressed-p 3))
      (check (raygui:result-changed-p 3))
      (check (not (raygui:result-changed-p 1)))
      (check (raygui:result-tab-close-p 4))
      (raygui:gui-disable)
      (check (= raygui:+state-disabled+ (raygui:gui-get-state)))
      (raygui:gui-enable)
      (check (= raygui:+state-normal+ (raygui:gui-get-state)))
      (raygui:gui-lock)
      (check (raygui:gui-is-locked))
      (raygui:gui-unlock)
      (check (not (raygui:gui-is-locked)))
      (raygui:gui-set-state raygui:+state-focused+)
      (check (= raygui:+state-focused+ (raygui:gui-get-state)))
      (raygui:gui-enable)
      (check (string= "#005#Open" (raygui:gui-icon-text raygui:+icon-file-open+ "Open")))
      (check (string= "#005#" (raygui:gui-icon-text raygui:+icon-file-open+ nil)))
      ;; Style access needs no drawing context while both default fonts are empty.
      (raygui:gui-set-style raygui:+button+ raygui:+base-color-normal+ #xff1122ff)
      (check (= #xff1122ff (raygui:gui-get-style raygui:+button+ raygui:+base-color-normal+)))
      (raygui:gui-set-style raygui:+button+ raygui:+base-color-normal+ -1)
      (check (= #xffffffff (raygui:gui-get-style raygui:+button+ raygui:+base-color-normal+)))
      (let* ((first (raygui:gui-icon-text raygui:+icon-file-save+ "Save"))
             (copy (copy-seq first)))
        (raygui:gui-icon-text raygui:+icon-folder-open+ "Other")
        (check (string= first copy)))
      (check (not (cffi:null-pointer-p (raygui:gui-get-icons))))
      (raygui:with-text-buffer (buffer 8 "hé")
        (check (string= "hé" (raygui:text-buffer-string buffer)))
        (setf (raygui:text-buffer-string buffer) "1234567")
        (check (string= "1234567" (raygui:text-buffer-string buffer)))
        (check (signals-error-p (lambda () (setf (raygui:text-buffer-string buffer) "12345678"))))
        (check (string= "1234567" (raygui:text-buffer-string buffer)))
        (setf (raygui:text-buffer-string buffer) "")
        (check (string= "" (raygui:text-buffer-string buffer)))
        (check (signals-error-p (lambda () (setf (raygui:text-buffer-string buffer)
                                                (string #\Null)))))
        (raygui:free-text-buffer buffer)
        (check (signals-error-p (lambda () (raygui:text-buffer-string buffer)))))
      (check (signals-error-p (lambda () (raygui:make-text-buffer 0))))
      (check (signals-error-p (lambda () (raygui:make-text-buffer 1 "x"))))
      (let ((buffer nil))
        (check (signals-error-p
                (lambda ()
                  (raygui:with-text-buffer (owned 16 "test")
                    (setf buffer owned)
                    (error "unwind")))))
        (check (cffi:null-pointer-p (raygui:text-buffer-pointer buffer))))
      (cl-raygui::call-with-string-array '("one" "二")
        (lambda (ptr size)
          (check (= 2 size))
          (check (string= "二" (cffi:foreign-string-to-lisp
                                 (cffi:mem-aref ptr :pointer 1) :encoding :utf-8)))))
      (cl-raygui::call-with-string-array #()
        (lambda (ptr size) (declare (ignore ptr)) (check (zerop size))))
      (raygui:gui-set-tooltip "A retained tooltip é")
      #+sbcl (sb-ext:gc :full t)
      (check (string= "A retained tooltip é"
                      (cffi:foreign-string-to-lisp cl-raygui::*tooltip-pointer* :encoding :utf-8)))
      (raygui:gui-set-tooltip nil)
      (check (cffi:null-pointer-p cl-raygui::*tooltip-pointer*))
      (check (raygui:load-raygui)))
    (format t "~&cl-raygui: ~D headless checks passed.~%" count)
    ;; Include native regression tests in the normal test command whenever the
    ;; optional probe has been built, so struct-call bugs cannot be overlooked.
    (let* ((root (asdf:system-source-directory :cl-raygui))
           (filename #+darwin "libraygui_abi_probe.dylib"
                     #+(and unix (not darwin)) "libraygui_abi_probe.so"
                     #+windows "raygui_abi_probe.dll"
                     #-(or darwin unix windows) "libraygui_abi_probe")
           (probe (or (uiop:getenv "CL_RAYGUI_ABI_PROBE")
                      (loop for directory in '("build/" "build/Release/" "build/Debug/")
                        for path = (merge-pathnames filename (merge-pathnames directory root))
                        when (probe-file path) return path))))
      (cond (probe (run-abi-tests probe))
            ((uiop:getenv "CL_RAYGUI_REQUIRE_NATIVE_TESTS")
             (error "ABI probe is required. Build with -DCL_RAYGUI_BUILD_TESTS=ON."))
            (t (format t "~&cl-raygui: ABI checks SKIPPED (native probe not built).~%"))))
    t))

(cl-raygui::define-control probe-pointers (bounds value active scroll view)
  ((value :float) (active cl-raygui.raw::c-bool)
   (scroll (:struct cl-raylib::%vector2)) (view (:struct cl-raylib::%rectangle)))
  (cffi:foreign-funcall "ClRayguiProbePointers"
    (:struct cl-raylib::%rectangle) bounds :pointer value :pointer active
    :pointer scroll :pointer view :int))

(cffi:defcfun ("ClRayguiProbeText" probe-text) :int
  (bounds (:struct cl-raylib::%rectangle))
  (text cl-raygui.raw::nullable-string))

(cffi:defcfun ("ClRayguiProbeTextPair" probe-text-pair) :int
  (bounds (:struct cl-raylib::%rectangle))
  (left cl-raygui.raw::nullable-string)
  (right cl-raygui.raw::nullable-string))

(cffi:defcfun ("ClRayguiProbeTextBox" probe-text-box) :int
  (bounds (:struct cl-raylib::%rectangle))
  (text :pointer)
  (text-size :int)
  (edit-mode cl-raygui.raw::c-bool))

(cffi:defcfun ("ClRayguiProbeDropdown" probe-dropdown) :int
  (bounds (:struct cl-raylib::%rectangle))
  (text cl-raygui.raw::nullable-string)
  (active :pointer)
  (edit-mode cl-raygui.raw::c-bool))

(cffi:defcfun ("ClRayguiProbeBool" probe-bool) cl-raygui.raw::c-bool
  (value cl-raygui.raw::c-bool))

(cffi:defcfun ("ClRayguiProbeBoolWithBounds" probe-bool-with-bounds) cl-raygui.raw::c-bool
  (bounds (:struct cl-raylib::%rectangle))
  (value cl-raygui.raw::c-bool))

(cffi:defcfun ("ClRayguiProbeSlider" probe-slider) :int
  (bounds (:struct cl-raylib::%rectangle))
  (left cl-raygui.raw::nullable-string)
  (right cl-raygui.raw::nullable-string)
  (value :pointer)
  (min-value :float)
  (max-value :float))

(defun run-abi-tests (library-path)
  "Check Lisp marshalling against a real C compiler, without a window."
  (let ((library (cffi:load-foreign-library library-path)))
    (unwind-protect
         (progn
           (loop for type in '(cl-raygui.raw::c-bool (:struct cl-raylib::%rectangle)
                              (:struct cl-raylib::%color) (:struct cl-raylib::%vector2)
                              (:struct cl-raylib::%vector3) (:struct cl-raylib::%font)
                              (:struct raygui:gui-style-prop))
                 for id from 0
                 do (assert (= (cffi:foreign-type-size type)
                               (cffi:foreign-funcall "ClRayguiProbeSize" :int id :size))))
           (let* ((bounds (cl-raylib:make-rectangle :x 10 :y 20 :width 30 :height 40))
                  (result (cffi:foreign-funcall "ClRayguiProbeRectangle"
                            (:struct cl-raylib::%rectangle) bounds
                            (:struct cl-raylib::%rectangle))))
             (assert (= 11 (cl-raylib:rectangle-x result)))
             (assert (= 22 (cl-raylib:rectangle-y result)))
             (assert (= 33 (cl-raylib:rectangle-width result)))
             (assert (= 44 (cl-raylib:rectangle-height result)))
             ;; Exercise the same libffi path as the example's first GuiLabel.
             (assert (= 34 (probe-text bounds "raygui 5.0 / Common Lisp")))
             (assert (= 13 (probe-text bounds "hé")))
             (assert (= 10 (probe-text bounds "")))
             (assert (= 9 (probe-text bounds nil)))
             (cffi:with-foreign-string (borrowed "borrowed" :encoding :utf-8)
               (assert (= 18 (probe-text bounds borrowed)))
               ;; Passing a foreign pointer must not release its storage.
               (assert (string= "borrowed" (cffi:foreign-string-to-lisp borrowed :encoding :utf-8))))
             (assert (= 19 (probe-text-pair bounds "left" "right")))
             (assert (= 14 (probe-text-pair bounds nil "right")))
             (assert (= 8 (probe-text-pair bounds nil nil)))
             (raygui:with-text-buffer (buffer 128 "initial")
               (assert (= 138 (probe-text-box bounds (raygui:text-buffer-pointer buffer) 128 nil)))
               (assert (string= "F" (raygui:text-buffer-string buffer)))
               (assert (= 138 (probe-text-box bounds (raygui:text-buffer-pointer buffer) 128 t)))
               (assert (string= "T" (raygui:text-buffer-string buffer))))
             (cffi:with-foreign-object (active :int)
               (setf (cffi:mem-ref active :int) 10)
               (assert (= 14 (probe-dropdown bounds "text" active nil)))
               (assert (= 9 (cffi:mem-ref active :int)))
               (assert (= 9 (probe-dropdown bounds nil active t)))
               (assert (= 10 (cffi:mem-ref active :int))))
             (assert (eq t (probe-bool nil)))
             (assert (null (probe-bool t)))
             (assert (eq t (probe-bool-with-bounds bounds nil)))
             (assert (null (probe-bool-with-bounds bounds t)))
             (cffi:with-foreign-object (value :float)
               (setf (cffi:mem-ref value :float) 0.5f0)
               (assert (= 9 (probe-slider bounds "left" "right" value 1.0f0 2.0f0)))
               (assert (= 33.5f0 (cffi:mem-ref value :float))))
             (multiple-value-bind (value active scroll view flags)
                 (probe-pointers bounds 1/2 nil (3d-vectors:vec 1 2)
                                 (cl-raylib:make-rectangle :x 0 :y 0 :width 0 :height 0))
               (assert (= 30.5 value))
               (assert (eq t active))
               (assert (= 11 (3d-vectors:vx scroll)))
               (assert (= 22 (3d-vectors:vy scroll)))
               (assert (= 30 (cl-raylib:rectangle-width view)))
               (assert (= raygui:+result-changed+ flags)))
             (assert (null (nth-value 1 (probe-pointers bounds 0 t (3d-vectors:vec 0 0) bounds)))))
           (let ((color (cffi:foreign-funcall "ClRayguiProbeColor"
                          (:struct cl-raylib::%color) '(10 20 30 255)
                          (:struct cl-raylib::%color))))
             (assert (= color (cl-raylib:make-rgba 11 22 33 251))))
           (let* ((font (cl-raylib:make-font
                          :base-size 16 :glyph-count 96 :glyph-padding 2
                          :texture (cl-raylib:make-texture :id 42 :width 128 :height 128
                                                         :mipmaps 1 :format 7)
                          :recs (cffi:null-pointer) :glyphs (cffi:null-pointer)))
                  (result (cffi:foreign-funcall "ClRayguiProbeFont"
                            (:struct cl-raylib::%font) font (:struct cl-raylib::%font))))
             (assert (= 17 (cl-raylib:font-base-size result)))
             (assert (= 43 (cl-raylib:texture-id (cl-raylib:font-texture result))))
             (assert (cffi:null-pointer-p (cl-raylib::font-glyphs result))))
           (format t "~&cl-raygui: native ABI checks passed.~%")
           t)
      (cffi:close-foreign-library library))))

(defun run-graphics-tests ()
  "Render one hidden frame with the real library. Requires a working display."
  (let ((bounds (cl-raylib:make-rectangle :x 20 :y 20 :width 200 :height 30))
        (panel (cl-raylib:make-rectangle :x 20 :y 60 :width 240 :height 160)))
    (cl-raylib:set-config-flags 128) ; FLAG_WINDOW_HIDDEN
    (cl-raylib:init-window 640 480 "cl-raygui smoke test")
    (unwind-protect
         (progn
           (assert (cl-raylib:is-window-ready))
           (raygui:gui-load-style-default)
           (let ((font (raygui:gui-get-font)))
             (assert (typep font 'cl-raylib::font))
             (raygui:gui-set-font font))
           (raygui:gui-set-style raygui:+default+ raygui:+text-size+ 16)
           (assert (= 16 (raygui:gui-get-style raygui:+default+ raygui:+text-size+)))
           (cl-raylib:begin-drawing)
           (unwind-protect
                (raygui:with-text-buffer (buffer 64 "1.5")
                  (raygui:gui-disable)
                  ;; Disabled widgets do not change values or depend on pointer position.
                  (assert (not (raygui:gui-button bounds "button")))
                  (assert (not (raygui:gui-label-button bounds "label button")))
                  (assert (not (raygui:gui-window-box panel "window")))
                  (assert (eq t (raygui:gui-check-box bounds "checked" t)))
                  (assert (null (raygui:gui-toggle bounds "off" nil)))
                  (assert (= 1 (raygui:gui-toggle-group bounds "A;B" 1)))
                  (assert (= 1 (raygui:gui-toggle-slider bounds "A;B" 1)))
                  (assert (= 1 (raygui:gui-combo-box bounds "A;B" 1)))
                  (assert (= 1 (raygui:gui-dropdown-box bounds "A;B" 1 nil)))
                  (assert (= 5 (raygui:gui-spinner bounds "spinner" 5 0 10 nil)))
                  (assert (= 5 (raygui:gui-value-box bounds "value" 5 0 10 nil)))
                  (assert (= 0.5 (raygui:gui-slider bounds "left" "right" 1/2 0 1)))
                  (assert (= 0.5 (raygui:gui-slider-bar bounds nil nil 1/2 0 1)))
                  (assert (= 0.5 (raygui:gui-progress-bar bounds nil nil 1/2 0 1)))
                  (assert (= 0.5 (raygui:gui-color-bar-alpha bounds nil 1/2)))
                  (assert (= 180.0 (raygui:gui-color-bar-hue bounds nil 180)))
                  (assert (string= "1.5" (raygui:gui-text-box bounds buffer nil)))
                  (assert (= 1.5 (raygui:gui-value-box-float bounds "float" buffer 1.5 nil)))
                  (assert (= 1 (raygui:gui-list-view panel "A;B" 0 1)))
                  (assert (= 1 (raygui:gui-list-view-ex panel '("A" "B") 0 1 -1)))
                  (assert (= 1 (raygui:gui-tab-bar panel "A;B" 0 1)))
                  (assert (= 1 (raygui:gui-tab-bar-ex panel #("A" "B") 0 1 -1)))
                  (assert (= -1 (raygui:gui-message-box panel "title" "message" "OK")))
                  (assert (string= "1.5" (raygui:gui-text-input-box panel "title" "message" buffer "OK")))
                  (dolist (function '(raygui:gui-color-picker raygui:gui-color-panel))
                    (assert (= (cl-raylib:make-rgba 20 40 60 255)
                               (funcall function panel nil '(20 40 60 255)))))
                  (dolist (function '(raygui:gui-color-picker-hsv raygui:gui-color-panel-hsv))
                    (let ((hsv (funcall function panel nil (3d-vectors:vec 180.0 0.5 0.5))))
                      (assert (= 180.0 (3d-vectors:vx hsv)))))
                  (assert (typep (raygui:gui-grid panel nil 20 2) '3d-vectors:vec2))
                  (multiple-value-bind (scroll view result)
                      (raygui:gui-scroll-panel panel "scroll" panel (3d-vectors:vec 0 0))
                    (assert (typep scroll '3d-vectors:vec2))
                    (assert (typep view 'cl-raylib::rectangle))
                    (assert (integerp result)))
                  (dolist (function '(raygui:gui-label raygui:gui-group-box raygui:gui-line
                                      raygui:gui-panel raygui:gui-status-bar raygui:gui-dummy-rec))
                    (assert (integerp (funcall function bounds "text"))))
                  (raygui:gui-draw-icon raygui:+icon-file-open+ 300 20 1 :red)
                  (assert (plusp (raygui:gui-get-text-width "width"))))
             (cl-raylib:end-drawing))
           (format t "~&cl-raygui: graphics smoke test passed.~%")
           t)
      (raygui:gui-enable)
      (raygui:gui-set-tooltip nil)
      (cl-raylib:close-window))))
