(load (merge-pathnames "bootstrap.lisp" *load-truename*))
(let ((mode (or (uiop:getenv "CL_RAYGUI_TEST_MODE") "headless")))
  (cond ((string= mode "headless")
         (load (merge-pathnames "check-isolation.lisp" *load-truename*)))
        ((string= mode "interaction") (cl-raygui.tests:run-interaction-tests))
        ((string= mode "graphics") (cl-raygui.tests:run-graphics-tests))
        ((string= mode "examples")
         (load (merge-pathnames "check-examples.lisp" *load-truename*)))
        (t (error "Unknown test mode: ~S" mode))))
